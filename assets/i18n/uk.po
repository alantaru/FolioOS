msgstr "FolioOS буде видалено з цього диска:"

#: src/core/installer.c:373
#, c-format
msgid "− FolioOS · FAT32 · %s"
msgstr "− FolioOS · FAT32 · %s"

#: src/core/installer.c:378 src/core/installer.c:426 src/core/partitions.c:261
#, c-format
msgid "%s%s: %s → %s"
msgstr "%s%s: %s → %s"

